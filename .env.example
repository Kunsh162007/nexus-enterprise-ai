# ─────────────────────────────────────────────
# NEXUS Enterprise AI — Environment Variables
# ─────────────────────────────────────────────

# ── AI Providers ──────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
FEATHERLESS_API_KEY=your_featherless_api_key_here
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# ── Featherless Models ────────────────────────
FEATHERLESS_SCOUT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# ── Gemini Models ─────────────────────────────
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro

# ── Backend ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Frontend ──────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# ── Production (Vultr) ────────────────────────
# VITE_API_URL=https://your-domain.com
# VITE_WS_URL=wss://your-domain.com/ws

# ── Veea Lobster Trap (Transforming Enterprise hackathon) ──────────
# Get from: veea.com (hackathon partner)
# If not set, Guardian uses Gemini-based auditing as fallback
VEEA_LOBSTER_TRAP_KEY=your_veea_key_here
